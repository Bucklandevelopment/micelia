# =============================================================================
# IDM-CORE: IDMMORTALITY System - Configuración Central
# =============================================================================

# -----------------------------------------------------------------------------
# CORE SETTINGS
# -----------------------------------------------------------------------------
APP_NAME=idm-core
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# -----------------------------------------------------------------------------
# API GATEWAY
# -----------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8888
GATEWAY_WORKERS=1

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8501"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------------------------
# SERVICE ENDPOINTS (Microservicios)
# -----------------------------------------------------------------------------

# biohack-app (Salud)
HEALTH_SERVICE_URL=http://localhost:8080
HEALTH_SERVICE_ENABLED=true

# canela-molida (Investigación)
RESEARCH_SERVICE_URL=http://localhost:3690
RESEARCH_SERVICE_ENABLED=true

# ideacursi-tool (Educación)
EDUCATION_SERVICE_URL=http://localhost:5050
EDUCATION_SERVICE_ENABLED=true

# cybertools (Seguridad)
SECURITY_SERVICE_URL=http://localhost:8000
SECURITY_SERVICE_ENABLED=true

# -----------------------------------------------------------------------------
# DATABASES
# -----------------------------------------------------------------------------

# PostgreSQL (Event Store + Shared Data)
DATABASE_URL=postgresql+asyncpg://idm:idm_password@localhost:5432/idm_core
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Cache + Pub/Sub)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# LanceDB (Vector Store - Shared)
LANCEDB_URI=./data/vectors/lancedb

# -----------------------------------------------------------------------------
# AI SERVICES
# -----------------------------------------------------------------------------

# Ollama (LLM Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# CodKing (Motor IA Multi-Core)
CODKING_ENABLED=true
CODKING_MODEL_PATH=./models/codking
CODKING_DEVICE=auto

# Compute Router
COMPUTE_ROUTER_ENABLED=true
PREFER_LOCAL=true

# Cloud Providers (Fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# ENERGY SYSTEM
# -----------------------------------------------------------------------------
ENERGY_MONITOR_ENABLED=true
ENERGY_CHECK_INTERVAL=30

# Solar Integration (opcional)
SOLAR_API_URL=
SOLAR_API_TYPE=generic

# UPS Integration (opcional)
UPS_API_URL=

# -----------------------------------------------------------------------------
# EVENT SOURCING
# -----------------------------------------------------------------------------
EVENT_STORE_ENABLED=true
EVENT_RETENTION_DAYS=365
EVENT_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Health Checks
HEALTH_CHECK_INTERVAL=30
SERVICE_TIMEOUT=10

# -----------------------------------------------------------------------------
# OSASCRIPT SECURITY (macOS System Control)
# -----------------------------------------------------------------------------
# Enable/disable OSASCRIPT module entirely
OSASCRIPT_ENABLED=true

# Require API key authentication for all OSASCRIPT endpoints
# Set to false for development/testing only
OSASCRIPT_REQUIRE_AUTH=true

# Rate limit per minute per IP
OSASCRIPT_RATE_LIMIT=30

# Allow high-risk operations (toggle_dark_mode, set_volume, open_url, etc.)
# Set to false in production for maximum security
OSASCRIPT_ALLOW_HIGH_RISK=false

# Comma-separated list of disabled operations
# Example: toggle_dark_mode,set_volume,open_url_in_safari
OSASCRIPT_DISABLED_OPERATIONS=

# Comma-separated list of allowed path prefixes for reveal_in_finder
OSASCRIPT_ALLOWED_PATHS=/Users/,/tmp/,/var/folders/

# API Key for OSASCRIPT endpoints (master key with full access)
# IMPORTANT: Change this in production!
SYSTEM_API_KEY=change-me-in-production

# Read-only API key (optional, for monitoring/read operations only)
SYSTEM_API_KEY_READONLY=

# -----------------------------------------------------------------------------
# DOCKER COMPOSE PORTS (referencia)
# -----------------------------------------------------------------------------
# idm-core gateway:    8888
# biohack-app:           8080
# canela-molida:         3690
# ideacursi-tool:        5050
# cybertools:            8000
# postgresql:            5432
# redis:                 6379
# ollama:                11434
# prometheus:            9090
# grafana:               3000
