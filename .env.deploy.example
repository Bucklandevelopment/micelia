# ─────────────────────────────────────────────────────────
# IDMMORTALITY — Configuración de Deploy SFTP (IONOS)
# ─────────────────────────────────────────────────────────
# Copia este archivo como .env.deploy y rellena tus datos:
#   cp .env.deploy.example .env.deploy
#
# Encuentra estos datos en IONOS:
#   Panel > Hosting > Acceso SFTP
# ─────────────────────────────────────────────────────────

# Host SFTP de IONOS (lo encuentras en el panel de acceso SFTP)
SFTP_HOST=access123456789.webspace-data.io

# Usuario SFTP de IONOS
SFTP_USER=u12345678

# Puerto (normalmente 22 para SFTP)
SFTP_PORT=22

# Ruta a clave SSH privada (opcional, si no se usa contraseña)
# SFTP_KEY_PATH=~/.ssh/ionos_key

# Directorio raíz en el webspace donde se sube el contenido
# En IONOS normalmente es / o /htdocs
REMOTE_BASE=/
