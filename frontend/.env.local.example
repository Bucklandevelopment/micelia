# =============================================================================
# Frontend Micelia — variables de entorno locales
# =============================================================================
#
# Copia este archivo a `.env.local` y ajusta los valores. Next.js lo carga
# automáticamente en `next dev` y `next build`.
#
# Las variables prefijadas con NEXT_PUBLIC_ son expuestas al bundle del
# cliente. NO pongas secretos ahí.

# ---- Backend ----
# URL del orquestador Micelia (FastAPI). Usada por las rewrites de
# `next.config.js`. Por defecto: http://localhost:8888.
IDM_CORE_API_URL=http://localhost:8888

# ---- Modo mock (MSW) ----
# Si está en "true", MSW intercepta TODAS las llamadas a /api/v1/* en el
# cliente y devuelve datos sintéticos definidos en `src/mocks/handlers.ts`.
# Esto permite navegar el dashboard sin levantar el backend.
#
# Cómo activar:
#   1. NEXT_PUBLIC_USE_MOCK=true
#   2. cd frontend && npm run msw:init   (sólo la primera vez)
#   3. make frontend-dev-mock            (o npm run dev:mock)
#
# Pasos detallados en frontend/README.md.
NEXT_PUBLIC_USE_MOCK=false

# ---- Frontends de los dominios (página /servicios) ----
# URLs a las que enlaza el hub de servicios del panel. Por defecto apuntan al mapa
# de puertos nativo local (ver scripts/run-ecosystem.sh). Cámbialas para apuntar a
# los subdominios de idmmortality.com cuando se despliegue.
NEXT_PUBLIC_BIOHACK_URL=http://localhost:5173
NEXT_PUBLIC_CANELA_URL=http://localhost:8501
NEXT_PUBLIC_IDEACURSI_URL=http://localhost:6060
NEXT_PUBLIC_CYBERTOOLS_URL=http://localhost:8000/docs
NEXT_PUBLIC_CODKING_URL=http://localhost:3009
NEXT_PUBLIC_AUTOMATION_URL=http://localhost:8891
